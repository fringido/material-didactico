        {
            "id": "configuraciones-bjt",
            "nombre": "Configuraciones BJT",
            "descripcion": "Análisis detallado de emisor común, base común y colector común.",
            "ecuaciones": [
                {
                    "nombre": "Ganancia emisor común",
                    "formula": "A_v = -\\frac{R_C}{r_e + R_E'}"
                },
                {
                    "nombre": "Impedancia entrada EC",
                    "formula": "Z_{in} = \\beta(r_e + R_E')"
                },
                {
                    "nombre": "Ganancia base común",
                    "formula": "A_v = \\frac{R_C}{r_e}"
                },
                {
                    "nombre": "Impedancia entrada BC",
                    "formula": "Z_{in} = r_e"
                },
                {
                    "nombre": "Ganancia colector común",
                    "formula": "A_v \\approx 1"
                },
                {
                    "nombre": "Impedancia entrada CC",
                    "formula": "Z_{in} = \\beta(R_E || R_L)"
                }
            ],
            "contenido": {
                "configuraciones": [
                    {
                        "nombre": "Emisor Común (Common Emitter)",
                        "descripcion": "Entrada en base, salida en colector, emisor a tierra (o con resistencia)",
                        "caracteristicas": [
                            "Alta ganancia de voltaje (typical 20-200)",
                            "Ganancia de corriente moderada (β)",
                            "Desfase de 180° entre entrada y salida",
                            "Impedancia de entrada media (1-10 kΩ)",
                            "Impedancia de salida media-alta"
                        ],
                        "aplicaciones": "Amplificación general, etapas intermedias",
                        "ventajas": "Versátil, buena ganancia",
                        "desventajas": "Inversión de fase, respuesta en frecuencia limitada"
                    },
                    {
                        "nombre": "Base Común (Common Base)",
                        "descripcion": "Entrada en emisor, salida en colector, base a tierra (AC)",
                        "caracteristicas": [
                            "Ganancia de voltaje alta (similar a EC)",
                            "Ganancia de corriente < 1 (α ≈ 0.99)",
                            "Sin desfase (0°)",
                            "Impedancia de entrada muy baja (10-100 Ω)",
                            "Impedancia de salida alta"
                        ],
                        "aplicaciones": "RF, adaptación de impedancia baja",
                        "ventajas": "Buena respuesta en alta frecuencia",
                        "desventajas": "Baja impedancia de entrada"
                    },
                    {
                        "nombre": "Colector Común (Common Collector / Emitter Follower)",
                        "descripcion": "Entrada en base, salida en emisor, colector a tierra (AC)",
                        "caracteristicas": [
                            "Ganancia de voltaje ≈ 1",
                            "Ganancia de corriente alta (β+1)",
                            "Sin desfase (0°)",
                            "Impedancia de entrada muy alta (10-100 kΩ)",
                            "Impedancia de salida muy baja"
                        ],
                        "aplicaciones": "Buffer, adaptación de impedancia, etapa de salida",
                        "ventajas": "Alta impedancia entrada, baja salida",
                        "desventajas": "Sin ganancia de voltaje"
                    }
                ],
                "ejemplos": [
                    {
                        "titulo": "Cálculo de ganancia EC",
                        "enunciado": "Amplificador EC con R_C=2kΩ, R_E=200Ω, β=100, V_BE=0.7V, I_C=2mA. Calcular A_v y Z_in.",
                        "solucion": [
                            "r_e = 26mV / I_C = 26/2 = 13 Ω",
                            "A_v = -R_C / r_e = -2000/13 ≈ -154",
                            "Z_in = β(r_e + R_E) = 100(13 + 200) = 21.3 kΩ"
                        ]
                    }
                ]
            }
        },
        {
            "id": "punto-operacion-q",
            "nombre": "Punto de Operación Q",
            "descripcion": "Punto de reposo del transistor (sin señal) que determina el rango de operación.",
            "ecuaciones": [
                {
                    "nombre": "Corriente de colector Q",
                    "formula": "I_{CQ} = \\beta I_{BQ}"
                },
                {
                    "nombre": "Voltaje colector-emisor Q",
                    "formula": "V_{CEQ} = V_{CC} - I_{CQ}R_C - I_{E Q}R_E"
                },
                {
                    "nombre": "Resistencia emisor para estabilidad",
                    "formula": "R_E = \\frac{V_E}{I_{CQ}} = \\frac{0.1V_{CC}}{I_{CQ}}"
                }
            ],
            "contenido": {
                "conceptos": [
                    {
                        "nombre": "Punto Q (Quiescent Point)",
                        "descripcion": "Punto de operación en DC sin señal aplicada",
                        "coordenadas": "(I_CQ, V_CEQ)",
                        "importancia": "Determina rango lineal, máxima excursión de señal"
                    },
                    {
                        "nombre": "Región de saturación",
                        "descripcion": "V_CE < V_CE(sat) ≈ 0.2V",
                        "comportamiento": "Transistor completamente encendido"
                    },
                    {
                        "nombre": "Región de corte",
                        "descripcion": "I_C ≈ 0",
                        "comportamiento": "Transistor completamente apagado"
                    },
                    {
                        "nombre": "Región activa",
                        "descripcion": "V_CE > V_CE(sat), I_C > 0",
                        "comportamiento": "Amplificación lineal"
                    }
                ],
                "criterios_diseño": [
                    "Punto Q debe estar en centro de recta de carga para máxima excursión",
                    "Margen de seguridad para variaciones de temperatura y β",
                    "Estabilidad térmica con resistencia de emisor"
                ],
                "ejemplos": [
                    {
                        "titulo": "Cálculo de punto Q",
                        "enunciado": "Circuito con V_CC=12V, R_C=2kΩ, R_E=500Ω, β=100, polarización por división de voltaje. I_CQ=2mA.",
                        "solucion": [
                            "I_EQ ≈ I_CQ = 2mA",
                            "V_E = I_EQ × R_E = 0.002 × 500 = 1V",
                            "V_C = V_CC - I_CQ × R_C = 12 - 0.002 × 2000 = 8V",
                            "V_CEQ = V_C - V_E = 8 - 1 = 7V",
                            "Punto Q: (2mA, 7V)"
                        ]
                    }
                ]
            }
        },
        {
            "id": "recta-carga",
            "nombre": "Recta de Carga DC y AC",
            "descripcion": "Análisis gráfico del comportamiento del transistor mediante rectas de carga.",
            "ecuaciones": [
                {
                    "nombre": "Ecuación recta de carga DC",
                    "formula": "I_C = \\frac{V_{CC} - V_{CE}}{R_C + R_E}"
                },
                {
                    "nombre": "Intersección eje I_C (saturación)",
                    "formula": "I_{C(sat)} = \\frac{V_{CC}}{R_C + R_E}"
                },
                {
                    "nombre": "Intersección eje V_CE (corte)",
                    "formula": "V_{CE(cutoff)} = V_{CC}"
                },
                {
                    "nombre": "Resistencia de carga AC",
                    "formula": "R_{L(AC)} = R_C || R_L"
                }
            ],
            "contenido": {
                "recta_dc": {
                    "descripcion": "Representa comportamiento en DC (sin señal)",
                    "procedimiento": [
                        "Trazar línea entre I_C(sat) y V_CE(cutoff)",
                        "Ubicar punto Q sobre esta recta",
                        "Determinar márgenes de saturación y corte"
                    ]
                },
                "recta_ac": {
                    "descripcion": "Representa comportamiento con señal AC",
                    "procedimiento": [
                        "Calcular R_L(AC) = R_C || R_L",
                        "Recta AC pasa por punto Q con pendiente -1/R_L(AC)",
                        "Determinar máxima excursión de señal"
                    ]
                },
                "ejemplos": [
                    {
                        "titulo": "Análisis de recta de carga",
                        "enunciado": "V_CC=20V, R_C=4kΩ, R_E=1kΩ, R_L=4kΩ. Calcular rectas DC y AC.",
                        "solucion": [
                            "I_C(sat) = 20V/(4k+1k) = 4mA",
                            "V_CE(cutoff) = 20V",
                            "R_L(AC) = 4k || 4k = 2kΩ",
                            "Pendiente AC = -1/2k = -0.5 mA/V"
                        ]
                    }
                ]
            }
        },
        {
            "id": "polarizacion-transistores",
            "nombre": "Polarización de Transistores",
            "descripcion": "Métodos para establecer el punto de operación Q estable.",
            "ecuaciones": [
                {
                    "nombre": "Polarización por división de voltaje",
                    "formula": "V_B = V_{CC} \\cdot \\frac{R_2}{R_1 + R_2}"
                },
                {
                    "nombre": "Corriente base",
                    "formula": "I_B = \\frac{V_B - V_{BE}}{R_E(\\beta + 1)}"
                },
                {
                    "nombre": "Corriente colector",
                    "formula": "I_C = \\beta I_B"
                },
                {
                    "nombre": "Polarización por retroalimentación de colector",
                    "formula": "I_B = \\frac{V_{CC} - V_{BE}}{R_B + (\\beta + 1)R_C}"
                }
            ],
            "contenido": {
                "metodos": [
                    {
                        "nombre": "Polarización fija",
                        "descripcion": "Resistencia simple de base",
                        "ecuacion": "I_B = (V_CC - V_BE)/R_B",
                        "ventajas": "Simple",
                        "desventajas": "Muy inestable, dependiente de β y temperatura"
                    },
                    {
                        "nombre": "Polarización por retroalimentación de colector",
                        "descripcion": "Resistencia de base conectada a colector",
                        "ventajas": "Más estable que polarización fija",
                        "desventajas": "Aún dependiente de β"
                    },
                    {
                        "nombre": "Polarización por división de voltaje",
                        "descripcion": "Dos resistencias forman divisor en base",
                        "ventajas": "Muy estable, independiente de β",
                        "desventajas": "Requiere más componentes",
                        "criterio": "I_R1, I_R2 >> I_B (tipical 10×)"
                    },
                    {
                        "nombre": "Polarización con emisor",
                        "descripcion": "Resistencia de emisor para estabilidad térmica",
                        "ventajas": "Excelente estabilidad térmica",
                        "desventajas": "Reduce ganancia si no bypass"
                    }
                ],
                "estabilidad_termica": {
                    "efectos": [
                        "β aumenta con temperatura",
                        "V_BE disminuye con temperatura (~-2mV/°C)",
                        "I_C aumenta con temperatura"
                    ],
                    "soluciones": [
                        "Usar resistencia de emisor (R_E)",
                        "Polarización por división de voltaje",
                        "Compensación con diodos o transistores"
                    ]
                },
                "ejemplos": [
                    {
                        "titulo": "Diseño de polarización",
                        "enunciado": "Diseñar polarización por división para I_CQ=2mA, V_CEQ=6V, V_CC=12V, β=100.",
                        "solucion": [
                            "Seleccionar R_E = 0.1V_CC/I_C = 1.2/0.002 = 600Ω",
                            "V_E = I_C × R_E = 0.002 × 600 = 1.2V",
                            "V_B = V_E + V_BE = 1.2 + 0.7 = 1.9V",
                            "R_C = (V_CC - V_CE - V_E)/I_C = (12-6-1.2)/0.002 = 2.4kΩ",
                            "I_R = 10×I_B = 10×(I_C/β) = 10×0.02 = 0.2mA",
                            "R_2 = V_B/I_R = 1.9/0.0002 = 9.5kΩ",
                            "R_1 = (V_CC - V_B)/I_R = (12-1.9)/0.0002 = 50.5kΩ"
                        ]
                    }
                ]
            }
        },
        {
            "id": "amplificadores-potencia",
            "nombre": "Amplificadores de Potencia",
            "descripcion": "Etapas de salida para entregar potencia a la carga con alta eficiencia.",
            "ecuaciones": [
                {
                    "nombre": "Potencia de salida",
                    "formula": "P_{out} = \\frac{V_{out(rms)}^2}{R_L}"
                },
                {
                    "nombre": "Potencia de entrada DC",
                    "formula": "P_{DC} = V_{CC} I_{DC}"
                },
                {
                    "nombre": "Eficiencia",
                    "formula": "\\eta = \\frac{P_{out}}{P_{DC}} \\times 100\\%"
                },
                {
                    "nombre": "Disipación de potencia",
                    "formula": "P_D = P_{DC} - P_{out}"
                }
            ],
            "contenido": {
                "tipos": [
                    {
                        "nombre": "Amplificador Clase A",
                        "descripcion": "Un transistor conduce todo el ciclo",
                        "potencia_maxima": "V_CC²/(2R_L)",
                        "disipacion_maxima": "V_CC²/(2R_L) (sin señal)",
                        "aplicacion": "Audio de baja potencia, preamplificadores"
                    },
                    {
                        "nombre": "Push-Pull Clase B",
                        "descripcion": "Dos transistores NPN/PNP en configuración complementaria",
                        "potencia_maxima": "V_CC²/(2R_L)",
                        "disipacion_maxima": "V_CC²/(4π²R_L)",
                        "aplicacion": "Audio de potencia, etapas de salida"
                    },
                    {
                        "nombre": "Push-Pull Clase AB",
                        "descripcion": "Similar a Clase B con pequeña polarización",
                        "ventajas": "Elimina distorsión de cruce",
                        "aplicacion": "Audio integrado, amplificadores de potencia"
                    }
                ],
                "consideraciones_diseño": [
                    "Disipación de potencia en transistores (heat sinks)",
                    "Protección contra cortocircuito",
                    "Matching de transistores en push-pull",
                    "Capacitores de acoplamiento y bypass"
                ],
                "ejemplos": [
                    {
                        "titulo": "Cálculo de potencia Clase B",
                        "enunciado": "Amplificador push-pull con V_CC=±20V, R_L=8Ω. Calcular P_out máxima.",
                        "solucion": [
                            "V_peak ≈ V_CC = 20V",
                            "V_rms = 20/√2 ≈ 14.14V",
                            "P_out = V_rms²/R_L = 14.14²/8 ≈ 25W",
                            "P_DC = (2V_CC × V_peak)/(πR_L) = (40×20)/(π×8) ≈ 31.8W",
                            "η = 25/31.8 × 100% ≈ 78.5%"
                        ]
                    }
                ]
            }
        },

    "temas": [
        {
            "id": "principio-oscilacion",
            "nombre": "Principio de Oscilación",
            "descripcion": "Fundamentos teóricos de la generación de señales periódicas.",
            "ecuaciones": [
                {
                    "nombre": "Criterio de Barkhausen (magnitud)",
                    "formula": "|A\\beta| \\geq 1"
                },
                {
                    "nombre": "Criterio de Barkhausen (fase)",
                    "formula": "\\angle A\\beta = 0^\\circ \\text{ o } 360^\\circ"
                },
                {
                    "nombre": "Frecuencia de oscilación",
                    "formula": "f_0 = \\frac{1}{2\\pi\\sqrt{LC}}"
                },
                {
                    "nombre": "Condición de inicio",
                    "formula": "|A\\beta| > 1 \\text{ (para iniciar)}"
                },
                {
                    "nombre": "Condición de mantenimiento",
                    "formula": "|A\\beta| = 1 \\text{ (estado estable)}"
                }
            ],
            "contenido": {
                "conceptos": [
                    {
                        "nombre": "Retroalimentación positiva",
                        "descripcion": "Parte de la salida se realimenta a la entrada en fase",
                        "importancia": "Esencial para mantener la oscilación"
                    },
                    {
                        "nombre": "Ganancia de lazo (Aβ)",
                        "descripcion": "Producto de ganancia del amplificador y red de retroalimentación",
                        "criterio": "Debe ser ≥ 1 para oscilación"
                    },
                    {
                        "nombre": "Desplazamiento de fase",
                        "descripcion": "El desplazamiento total del lazo debe ser 0° o múltiplo de 360°",
                        "importancia": "Determina la frecuencia de oscilación"
                    },
                    {
                        "nombre": "Estabilidad de amplitud",
                        "descripcion": "Mecanismos para limitar la amplitud y evitar saturación",
                        "metodos": "No-linealidad, control automático de ganancia"
                    }
                ],
                "tipos_osciladores": [
                    "Osciladores LC (alta frecuencia, RF)",
                    "Osciladores RC (baja frecuencia, audio)",
                    "Osciladores de cristal (muy alta estabilidad)",
                    "Osciladores de relajación (formas de onda no senoidales)"
                ]
            }
        },
        {
            "id": "osciladores-lc",
            "nombre": "Osciladores LC",
            "descripcion": "Osciladores basados en circuitos resonantes LC para RF.",
            "ecuaciones": [
                {
                    "nombre": "Frecuencia resonante",
                    "formula": "f_0 = \\frac{1}{2\\pi\\sqrt{LC}}"
                },
                {
                    "nombre": "Oscilador Colpitts",
                    "formula": "f_0 = \\frac{1}{2\\pi\\sqrt{L C_T}}, \\quad C_T = \\frac{C_1 C_2}{C_1 + C_2}"
                },
                {
                    "nombre": "Oscilador Hartley",
                    "formula": "f_0 = \\frac{1}{2\\pi\\sqrt{L_T C}}, \\quad L_T = L_1 + L_2"
                },
                {
                    "nombre": "Relación de capacitores Colpitts",
                    "formula": "\\frac{C_2}{C_1} \\geq \\beta"
                }
            ],
            "contenido": {
                "colpitts": {
                    "descripcion": "Usa divisor capacitivo en la red de retroalimentación",
                    "configuracion": "Dos capacitores en serie con inductor",
                    "ventajas": "Buena estabilidad, fácil implementación",
                    "aplicaciones": "RF, VHF, UHF",
                    "rango_frecuencia": "kHz a GHz",
                    "ejemplo_diseño": {
                        "enunciado": "Diseñar Colpitts para f=10MHz con L=10μH.",
                        "solucion": [
                            "C_T = 1/(4π²f²L) = 1/(4π²×10¹⁴×10⁻⁵) ≈ 25.3pF",
                            "Seleccionar C1 = 50pF, C2 = 50pF",
                            "C_T = (50×50)/(50+50) = 25pF ✓"
                        ]
                    }
                },
                "hartley": {
                    "descripcion": "Usa divisor inductivo en la red de retroalimentación",
                    "configuracion": "Dos inductores en serie con capacitor",
                    "ventajas": "Sintonización fácil con capacitor variable",
                    "desventajas": "Más difícil de integrar que Colpitts",
                    "aplicaciones": "RF, sintonización AM/FM"
                },
                "otros_lc": [
                    {
                        "nombre": "Oscilador Pierce",
                        "descripcion": "Variante de Colpitts para cristales",
                        "aplicacion": "Relojes, microcontroladores"
                    },
                    {
                        "nombre": "Oscilador Clapp",
                        "descripcion": "Colpitts con capacitor adicional en serie",
                        "ventaja": "Mejor estabilidad de frecuencia"
                    }
                ]
            }
        },

            "id": "pll-vco",
            "nombre": "PLL y VCO",
            "descripcion": "Phase-Locked Loop y Voltage-Controlled Oscillator para síntesis de frecuencia.",
            "ecuaciones": [
                {
                    "nombre": "Frecuencia VCO",
                    "formula": "f_{out} = f_{center} + K_{VCO} V_{control}"
                },
                {
                    "nombre": "Sensibilidad VCO",
                    "formula": "K_{VCO} = \\frac{\\Delta f}{\\Delta V} \\text{ [Hz/V]}"
                },
                {
                    "nombre": "Frecuencia salida PLL",
                    "formula": "f_{out} = N \\cdot f_{ref}"
                },
                {
                    "nombre": "Ancho de banda PLL",
                    "formula": "\\omega_n = \\sqrt{\\frac{K_{PD} K_{VCO}}{N \\tau}}"
                }
            ],
            "contenido": {
                "pll": {
                    "descripcion": "Sistema de control en lazo cerrado para sincronizar fase y frecuencia",
                    "componentes": [
                        {
                            "nombre": "Phase Detector (PD)",

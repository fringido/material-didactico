                        {
                            "nombre": "VCO",
                            "funcion": "Genera frecuencia proporcional a voltaje de control",
                            "salida": "Señal de frecuencia variable"
                        },
                        {
                            "nombre": "Feedback Divider (N)",
                            "funcion": "Divide frecuencia de salida",
                            "resultado": "f_out = N × f_ref"
                        }
                    ],
                    "estados": [
                        "Locked (bloqueado): fases sincronizadas",
                        "Unlocked (desbloqueado): buscando sincronización",

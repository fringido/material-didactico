                        "configuraciones": ["LP", "HP", "BP"],
                        "orden": "2do orden por etapa"
                    },
                    {
                        "nombre": "Multiple Feedback (MFB)",
                        "descripcion": "Topología alternativa",
                        "ventajas": "Buena para alta Q",
                        "desventajas": "Más sensible a tolerancias"
                    },
                    {
                        "nombre": "State Variable",
                        "descripcion": "Simultáneamente LP, HP, BP",
                        "ventajas": "Versátil, ajuste independiente",
                        "desventajas": "Más op-amps requeridos"
                    }
                ],
                "ejemplos": [
                    {
                        "titulo": "Filtro pasa-bajas Butterworth 2do orden",
                        "enunciado": "f_c = 1kHz, ganancia = 1.",
                        "solucion": [
                            "Seleccionar C = 10nF",
                            "R = 1/(2π × 1000 × 10×10⁻⁹) ≈ 15.9kΩ",
                            "Para K=1: Ra = ∞, Rb = 0 (seguidor)",
                            "Usar dos resistores y capacitores iguales"
                        ]
                    },
                    {
                        "titulo": "Filtro pasa-bandas Sallen-Key",
                        "enunciado": "f_0 = 1kHz, Q = 5, ganancia = 10.",
                        "solucion": [
                            "K = 10",
                            "Q = 1/(3-K) = 1/(3-10) = -0.14 (no válido)",
                            "Usar topología MFB para Q > 0.5"
                        ]
                    }
                ]
            }
        },

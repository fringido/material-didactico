    "temas": [
        {
            "id": "caracteristicas-opamp",
            "nombre": "Características Ideales vs Reales",
            "descripcion": "Parámetros que definen el comportamiento de amplificadores operacionales.",
            "ecuaciones": [
                {
                    "nombre": "Ganancia lazo abierto ideal",
                    "formula": "A_{OL} \\to \\infty"
                },
                {
                    "nombre": "Impedancia entrada ideal",
                    "formula": "Z_{in} \\to \\infty"
                },
                {
                    "nombre": "Impedancia salida ideal",
                    "formula": "Z_{out} \\to 0"
                },
                {
                    "nombre": "Corriente de entrada ideal",
                    "formula": "I_{in+} = I_{in-} = 0"
                },
                {
                    "nombre": "Voltaje de entrada ideal",
                    "formula": "V_+ = V_- \\text{ (virtual short)}"
                }
            ],
            "contenido": {
                "caracteristicas_ideales": [
                    {
                        "parametro": "Ganancia lazo abierto (AOL)",

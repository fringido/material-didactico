                    }
                ]
            }
        },
        {
            "id": "integrador-derivador",
            "nombre": "Integrador y Derivador",
            "descripcion": "Circuitos para operaciones matemáticas de integración y derivación.",
            "ecuaciones": [
                {
                    "nombre": "Integrador ideal",
                    "formula": "V_{out}(t) = -\\frac{1}{RC}\\int V_{in}(t) dt"
                },
                {
                    "nombre": "Frecuencia de corte integrador",
                    "formula": "f_c = \\frac{1}{2\\pi RC}"
                },
                {
                    "nombre": "Derivador ideal",
                    "formula": "V_{out}(t) = -RC \\frac{dV_{in}(t)}{dt}"
                },
                {
                    "nombre": "Integrador práctico (con resistor)",
                    "formula": "V_{out} = -\\frac{R_f}{R_{in}}V_{in} - \\frac{1}{R_{in}C}\\int V_{in} dt"
                }
            ],
            "contenido": {
                "integrador": {
                    "descripcion": "Realiza integración de la señal de entrada",
                    "configuracion": "Capacitor en retroalimentación, resistor en entrada",
                    "aplicaciones": [
                        "Integración de señales",
                        "Filtros pasa-bajas",
                        "Generación de rampas",
                        "Convertidores V-F"
                    ],
                    "problema": "Saturación por offset de DC",
                    "solucion": "Resistor en paralelo con capacitor (R_f >> R_in)",
                    "frecuencia_minima": "f_min = 1/(2πR_fC)",
                    "ejemplo": {
                        "enunciado": "Diseñar integrador para f_min = 10Hz, R_in = 10kΩ.",
                        "solucion": [
                            "Seleccionar C = 100nF",
                            "R_f = 1/(2π × 10 × 100×10⁻⁹) ≈ 159kΩ"
                        ]
                    }
                },
                "derivador": {
                    "descripcion": "Realiza derivación de la señal de entrada",
                    "configuracion": "Capacitor en entrada, resistor en retroalimentación",
                    "aplicaciones": [
                        "Detección de flancos",
                        "Filtros pasa-altas",
                        "Diferenciación de señales"
                    ],
                    "problemas": [
                        "Inestabilidad a alta frecuencia",
                        "Amplificación de ruido"
                    ],
                    "solucion": "Resistor pequeño en serie con capacitor",
                    "ejemplo": {
                        "enunciado": "Diseñar derivador con ganancia de -1 a 1kHz.",
                        "solucion": [
                            "RC = 1/(2π × 1000) ≈ 159μs",
                            "Seleccionar C = 10nF",
                            "R = 159μs / 10nF = 15.9kΩ"
                        ]
                    }

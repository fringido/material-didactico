        {
            "id": "parametros-importantes",
            "nombre": "Parámetros Importantes",
            "descripcion": "Parámetros críticos que afectan el rendimiento en aplicaciones reales.",
            "ecuaciones": [
                {
                    "nombre": "Ganancia lazo cerrado",
                    "formula": "A_{CL} = \\frac{A_{OL}}{1 + A_{OL}\\beta}"
                },
                {
                    "nombre": "Ancho de banda ganancia unidad",
                    "formula": "f_T = A_{OL(0)} \\times f_{3dB}"
                },
                {
                    "nombre": "Ancho de banda lazo cerrado",
                    "formula": "f_{CL} = \\frac{f_T}{A_{CL}}"
                },
                {
                    "nombre": "CMRR",
                    "formula": "CMRR = 20\\log_{10}\\left(\\frac{A_{DM}}{A_{CM}}\\right)"
                },
                {
                    "nombre": "Voltaje offset",
                    "formula": "V_{out} = A_{CL}(V_{in} + V_{os})"
                },
                {
                    "nombre": "Corriente bias",
                    "formula": "I_{bias} = \\frac{I_{B+} + I_{B-}}{2}"
                },
                {
                    "nombre": "Corriente offset",
                    "formula": "I_{os} = |I_{B+} - I_{B-}|"
                }
            ],
            "contenido": {
                "parametros_detalle": [
                    {
                        "nombre": "Ganancia lazo abierto (AOL)",
                        "descripcion": "Ganancia sin retroalimentación",
                        "tipico": "100,000 - 10,000,000",
                        "variacion": "Disminuye con frecuencia",
                        "importancia": "Determina error en ganancia lazo cerrado"
                    },
                    {
                        "nombre": "Ancho de banda (BW)",
                        "descripcion": "Rango de frecuencias donde opera correctamente",
                        "producto_ganancia_ancho": "Gain-Bandwidth Product (GBP)",
                        "relacion": "BW × Ganancia = constante",
                        "tipico": "1MHz - 100MHz"
                    },
                    {
                        "nombre": "Slew Rate",
                        "descripcion": "Máxima tasa de cambio de voltaje de salida",
                        "unidad": "V/μs",
                        "efecto": "Distorsión a alta frecuencia y amplitud",
                        "tipico": "0.5 - 1000 V/μs",
                        "calculo": "SR > 2πf_peak V_peak"
                    },
                    {
                        "nombre": "CMRR (Common Mode Rejection Ratio)",
                        "descripcion": "Capacidad de rechazar señales comunes a ambas entradas",
                        "unidad": "dB",
                        "importancia": "Crítico en amplificadores diferenciales",
                        "tipico": "80 - 120 dB"
                    },
                    {
                        "nombre": "Offset de voltaje (V_os)",
                        "descripcion": "Voltaje de salida cuando entradas están a cero",
                        "causa": "Mismatch interno de transistores",
                        "tipico": "0.1 - 10 mV",
                        "correccion": "Null offset pins"
                    },
                    {
                        "nombre": "Corrientes de entrada",
                        "descripcion": "Corrientes que fluyen en las entradas",
                        "tipos": ["Bias current", "Offset current"],
                        "tipico": "1nA - 1μA",
                        "efecto": "Crea offset si resistencias no balanceadas"
                    },
                    {
                        "nombre": "Ruido",
                        "descripcion": "Ruido generado internamente",
                        "tipos": ["Voltaje noise", "Current noise"],
                        "unidad": "nV/√Hz",
                        "aplicacion": "Circuitos de precisión, audio"
                    }
                ],
                "ejemplos": [
                    {
                        "titulo": "Cálculo de ancho de banda",
                        "enunciado": "Op-amp con GBP=10MHz, ganancia lazo cerrado=100. Calcular BW.",
                        "solucion": [
                            "BW = GBP / A_CL = 10MHz / 100 = 100kHz"
                        ]
                    },
                    {
                        "titulo": "Verificación de slew rate",
                        "enunciado": "Señal de 10V pico a 100kHz. SR mínimo requerido.",
                        "solucion": [
                            "SR > 2π × 100kHz × 10V = 6.28 V/μs"
                        ]
                    }
                ]
            }
        },
        {
            "id": "configuraciones-basicas",
            "nombre": "Configuraciones Básicas",
            "descripcion": "Amplificador inversor, no inversor, sumador y restador.",
            "ecuaciones": [
                {
                    "nombre": "Inversor",
                    "formula": "A_v = -\\frac{R_f}{R_{in}}"
                },
                {
                    "nombre": "Impedancia entrada inversor",
                    "formula": "Z_{in} = R_{in}"
                },
                {
                    "nombre": "No inversor",
                    "formula": "A_v = 1 + \\frac{R_f}{R_1}"
                },
                {
                    "nombre": "Impedancia entrada no inversor",
                    "formula": "Z_{in} \\to \\infty"
                },
                {
                    "nombre": "Seguidor de voltaje",
                    "formula": "A_v = 1"
                },
                {
                    "nombre": "Sumador inversor",
                    "formula": "V_{out} = -R_f\\left(\\frac{V_1}{R_1} + \\frac{V_2}{R_2} + \\cdots\\right)"
                },
                {
                    "nombre": "Restador (diferencial)",
                    "formula": "V_{out} = \\frac{R_f}{R_1}(V_2 - V_1)"
                }
            ],
            "contenido": {
                "configuraciones": [
                    {
                        "nombre": "Amplificador Inversor",
                        "descripcion": "Entrada en terminal inversor, no inversor a tierra",
                        "ganancia": "A_v = -R_f/R_in",
                        "impedancia_entrada": "Z_in = R_in",
                        "impedancia_salida": "Baja",
                        "aplicaciones": "Amplificación general, mezcla de señales",
                        "ventajas": "Ganancia precisa, fácil diseño",
                        "desventajas": "Impedancia de entrada limitada"
                    },
                    {
                        "nombre": "Amplificador No Inversor",
                        "descripcion": "Entrada en terminal no inversor",
                        "ganancia": "A_v = 1 + R_f/R_1",
                        "impedancia_entrada": "Muy alta",
                        "aplicaciones": "Buffer, alta impedancia de entrada",
                        "ventajas": "Alta Z_in, sin inversión",
                        "desventajas": "Ganancia mínima = 1"
                    },
                    {
                        "nombre": "Seguidor de Voltaje (Buffer)",
                        "descripcion": "R_f = 0, R_1 = ∞ (configuración no inversor)",
                        "ganancia": "A_v = 1",
                        "impedancia_entrada": "Muy alta",
                        "impedancia_salida": "Muy baja",
                        "aplicaciones": "Buffer, adaptación de impedancia",
                        "ventajas": "Aislamiento perfecto"
                    },
                    {
                        "nombre": "Sumador Inversor",
                        "descripcion": "Múltiples entradas en terminal inversor",
                        "salida": "Suma ponderada invertida",
                        "aplicaciones": "Mezcla de audio, procesamiento de señales",
                        "flexibilidad": "Pesos ajustables con resistencias"
                    },
                    {
                        "nombre": "Amplificador Diferencial",
                        "descripcion": "Dos entradas, amplifica diferencia",
                        "ganancia": "A_v = (R_f/R_1)(V_2 - V_1)",
                        "aplicaciones": "Instrumentación, rechazo de modo común",
                        "importancia": "Base de amplificadores de instrumentación"
                    }
                ],
                "ejemplos": [
                    {
                        "titulo": "Diseño inversor",
                        "enunciado": "Diseñar amplificador inversor con A_v = -10, Z_in = 10kΩ.",
                        "solucion": [
                            "R_in = 10kΩ",
                            "R_f = 10 × R_in = 100kΩ",
                            "A_v = -100k/10k = -10 ✓"
                        ]
                    },
                    {
                        "titulo": "Sumador de tres señales",
                        "enunciado": "Sumar V1, V2, V3 con pesos 1, 2, 3 respectivamente.",
                        "solucion": [
                            "Seleccionar R_f = 30kΩ",
                            "R1 = 30kΩ (peso 1)",
                            "R2 = 15kΩ (peso 2)",
                            "R3 = 10kΩ (peso 3)",
                            "V_out = -(V1 + 2V2 + 3V3)"

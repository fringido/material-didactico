            }
        },
        {
            "id": "comparadores",
            "nombre": "Comparadores",
            "descripcion": "Op-amps sin retroalimentación para comparación de voltajes.",
            "ecuaciones": [
                {
                    "nombre": "Salida comparador",
                    "formula": "V_{out} = \\begin{cases} V_{sat+} & \\text{si } V_+ > V_- \\\\ V_{sat-} & \\text{si } V_+ < V_- \\end{cases}"
                },
                {
                    "nombre": "Histéresis (Schmitt trigger)",
                    "formula": "V_{UTP} = V_{ref}\\frac{R_1}{R_1 + R_2}, \\quad V_{LTP} = V_{ref}\\frac{R_1}{R_1 + R_2} - V_{sat}\\frac{R_1}{R_2}"
                }
            ],
            "contenido": {
                "comparador_basico": {
                    "descripcion": "Op-amp en lazo abierto (sin retroalimentación)",
                    "comportamiento": "Salida satura a +V_sat o -V_sat",
                    "aplicaciones": [
                        "Detección de umbrales",
                        "Conversión A/D simple",
                        "Generación de onda cuadrada",
                        "Control de encendido/apagado"
                    ],
                    "problema": "Ruido puede causar múltiples transiciones",
                    "solucion": "Histéresis (Schmitt trigger)"
                },
                "schmitt_trigger": {
                    "descripcion": "Comparador con retroalimentación positiva",
                    "ventajas": [
                        "Inmunidad al ruido",
                        "Transiciones limpias",
                        "Dos umbrales (UTP, LTP)"
                    ],
                    "tipos": [
                        "Inversor (retroalimentación a entrada +)",
                        "No inversor (retroalimentación a entrada -)"
                    ],
                    "aplicaciones": [
                        "Limpieza de señales ruidosas",
                        "Generación de onda cuadrada",
                        "Debounce de interruptores"
                    ],
                    "ejemplo": {
                        "enunciado": "Diseñar Schmitt trigger no inversor con V_ref=0, V_sat=±15V, hysteresis=1V.",
                        "solucion": [
                            "V_hyst = 2V_sat × R1/(R1+R2) = 1V",
                            "30 × R1/(R1+R2) = 1",
                            "R1/(R1+R2) = 1/30",
                            "Seleccionar R1 = 1kΩ, R2 = 29kΩ"
                        ]
                    }
                }
            }
        },
        {
            "id": "filtros-activos",
            "nombre": "Filtros Activos",
            "descripcion": "Filtros usando op-amps: Butterworth, Chebyshev, Bessel, Sallen-Key.",
            "ecuaciones": [
                {
                    "nombre": "Ganancia filtro Sallen-Key",
                    "formula": "K = 1 + \\frac{R_a}{R_b}"
                },
                {
                    "nombre": "Frecuencia de corte",
                    "formula": "f_c = \\frac{1}{2\\pi RC}"
                },
                {
                    "nombre": "Factor Q",
                    "formula": "Q = \\frac{1}{3 - K}"
                },
                {
                    "nombre": "Atenuación Butterworth",
                    "formula": "A_{dB} = -20n\\log_{10}\\left(\\sqrt{1 + (\\frac{f}{f_c})^{2n}}\\right)"
                }
            ],
            "contenido": {
                "tipos_respuesta": [
                    {
                        "nombre": "Butterworth",
                        "descripcion": "Respuesta plana en banda de paso",
                        "caracteristica": "Máxima planitud",
                        "ripple_banda_paso": "0 dB",
                        "rolloff": "-20n dB/década",
                        "aplicaciones": "Audio, instrumentación"
                    },
                    {
                        "nombre": "Chebyshev",
                        "descripcion": "Rolloff más rápido con ripple en banda",
                        "caracteristica": "Atenuación más rápida",
                        "ripple_banda_paso": "0.5 - 3 dB",
                        "rolloff": "Más rápido que Butterworth",
                        "aplicaciones": "Filtros selectivos"
                    },
                    {
                        "nombre": "Bessel",
                        "descripcion": "Respuesta lineal en fase",
                        "caracteristica": "Mínima distorsión de pulso",
                        "ripple_banda_paso": "0 dB",
                        "rolloff": "Más lento que Butterworth",
                        "aplicaciones": "Pulsos, comunicaciones"
                    }
                ],
                "topologias": [
                    {
                        "nombre": "Sallen-Key",
                        "descripcion": "Topología más común para filtros activos",

    "temas": [
        {
            "id": "senales-senoidales",
            "nombre": "Señales Senoidales",
            "descripcion": "Parámetros fundamentales de señales AC: amplitud, frecuencia, período, fase y valor RMS.",
            "ecuaciones": [
                {
                    "nombre": "Señal senoidal",
                    "formula": "v(t) = V_m \\sin(\\omega t + \\phi)"
                },
                {
                    "nombre": "Frecuencia angular",
                    "formula": "\\omega = 2\\pi f = \\frac{2\\pi}{T}"
                },
                {
                    "nombre": "Valor RMS",
                    "formula": "V_{rms} = \\frac{V_m}{\\sqrt{2}}"
                },
                {
                    "nombre": "Valor promedio",
                    "formula": "V_{avg} = \\frac{2}{\\pi} V_m \\approx 0.637 V_m"
                }
            ]
        },
        {
            "id": "fasores-numeros-complejos",
            "nombre": "Fasores y Números Complejos",
            "descripcion": "Representación fasorial de señales senoidales y operaciones con números complejos.",
            "ecuaciones": [
                {
                    "nombre": "Representación fasorial",
                    "formula": "\\mathbf{V} = V_m \\angle \\phi = V_m e^{j\\phi}"
                },
                {
                    "nombre": "Forma rectangular",
                    "formula": "\\mathbf{V} = a + jb"
                },
                {
                    "nombre": "Conversión polar a rectangular",
                    "formula": "a = V_m \\cos\\phi, \\quad b = V_m \\sin\\phi"
                }
            ]
        },
        {
            "id": "impedancia-compleja",
            "nombre": "Impedancia Compleja",
            "descripcion": "Impedancia de resistencias, inductores y capacitores en el dominio de frecuencia.",
            "ecuaciones": [
                {
                    "nombre": "Impedancia de resistencia",
                    "formula": "\\mathbf{Z}_R = R"
                },
                {
                    "nombre": "Impedancia de inductor",
                    "formula": "\\mathbf{Z}_L = j\\omega L = jX_L"
                },
                {
                    "nombre": "Impedancia de capacitor",
                    "formula": "\\mathbf{Z}_C = \\frac{1}{j\\omega C} = -jX_C"
                }
            ]
        },
        {
            "id": "filtros-rc-rl-rlc",
            "nombre": "Filtros RC, RL y RLC",
            "descripcion": "Diseño y análisis de filtros pasa-bajas, pasa-altas, pasa-banda y rechaza-banda.",
            "ecuaciones": [
                {
                    "nombre": "Frecuencia de corte RC",
                    "formula": "f_c = \\frac{1}{2\\pi RC}"
                },
                {
                    "nombre": "Frecuencia de resonancia RLC",
                    "formula": "f_0 = \\frac{1}{2\\pi\\sqrt{LC}}"
                }
            ]
        }
    ],

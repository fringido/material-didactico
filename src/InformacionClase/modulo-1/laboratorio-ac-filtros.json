  "experimentos_especializados": [
    {
      "id": "exp_filtros_activos",
      "titulo": "Experimento 1: Diseño de Filtros Activos con Op-Amps",
      "objetivos": [
        "Diseñar filtros Sallen-Key de 2do orden",
        "Comparar respuesta Butterworth vs Chebyshev",
        "Medir ganancia y fase simultáneamente"
      ],
      "duracion": "120 min",
      "topologías": [
        {
          "tipo": "Sallen-Key Pasa-Bajas",
          "configuración": "Ganancia unitaria con buffer",
          "ecuaciones": [
            "fc = 1/(2π√(R1×R2×C1×C2))",
            "Q = √(R1×R2×C1×C2)/(R1×C2 + R2×C2 + R1×C1×(1-K))",
            "K = 1 + Rf/Rg (ganancia DC)"
          ],
          "diseño_ejemplo": {
            "fc_objetivo": "1kHz",
            "Q_butterworth": "0.707",
            "componentes": "R1=R2=1.59kΩ, C1=C2=100nF"
          }
        },
        {
          "tipo": "Filtro de Variables de Estado",
          "ventajas": [
            "Salidas simultáneas: pasa-bajas, pasa-altas, pasa-banda",
            "Q independiente de fc",
            "Baja sensibilidad a componentes"
          ]
        }
      ],
      "mediciones_requeridas": [
        {
          "parámetro": "Respuesta en frecuencia",
          "rango": "10Hz - 100kHz",
          "puntos_críticos": ["fc", "fc/10", "10×fc"]
        },
        {
          "parámetro": "Fase vs frecuencia",
          "análisis": "Retardo de grupo = -dφ/dω"
        },
        {
          "parámetro": "Respuesta al escalón",
          "correlación": "Sobreimpulso vs Q del filtro"
        }
      ]
    },
    {
      "id": "exp_resonancia_rlc",
      "titulo": "Experimento 2: Fenómenos de Resonancia en Circuitos RLC",
      "objetivos": [
        "Caracterizar resonancia serie y paralelo",
        "Medir factor Q experimentalmente",
        "Analizar transferencia de energía L ↔ C"
      ],
      "duracion": "90 min",
      "circuito_resonante": {
        "componentes": "L=47mH, C=100nF, R variable",
        "f0_teórica": "f0 = 1/(2π√LC) ≈ 2.32kHz",
        "Q_teórico": "Q = ωL/R = 2πf0L/R"
      },
      "procedimiento_experimental": [
        {
          "fase": "Barrido de frecuencia",
          "objetivo": "Localizar f0 experimental",
          "criterio": "Corriente máxima (serie) o mínima (paralelo)"
        },
        {
          "fase": "Medición de ancho de banda",
          "definición": "BW = f2 - f1 donde I = I_max/√2",
          "cálculo_Q": "Q = f0/BW"
        },
        {
          "fase": "Efecto de R en Q",
          "valores_R": ["10Ω", "50Ω", "100Ω", "500Ω"],
          "observación": "Q inversamente proporcional a R"
        }
      ],
      "aplicaciones_prácticas": [
        "Sintonización de receptores de radio",
        "Filtros de RF en comunicaciones",
        "Transformadores de acoplamiento",
        "Circuitos osciladores"
      ]
    },
    {
      "id": "exp_bode_analyzer",
      "titulo": "Experimento 3: Análisis de Bode con Instrumentación Real",
      "objetivos": [
        "Usar analizador de redes vectorial",
        "Generar diagramas de Bode automáticamente",
        "Correlacionar polos/ceros con respuesta"
      ],
      "duracion": "75 min",
      "instrumentación": {
        "analizador": "Simulación de HP 4395A o similar",
        "rango_frecuencia": "10Hz - 500MHz",
        "parámetros_s": ["S11", "S21", "S12", "S22"]
      },
      "circuitos_análisis": [
        {
          "circuito": "Filtro RC simple",
          "función_transferencia": "H(s) = 1/(1 + sRC)",
          "características": [
            "Un polo en s = -1/RC",
            "Atenuación -20dB/década después de fc",
            "Fase: 0° → -90°"
          ]
        },
        {
          "circuito": "Filtro RLC pasa-banda",
          "función_transferencia": "H(s) = (sRC)/(s²LC + sRC + 1)",
          "características": [
            "Dos polos complejos conjugados",
            "Cero en s = 0 y s = ∞",
            "Pico de resonancia si Q > 0.707"
          ]
        }
      ]
    }
  ],
